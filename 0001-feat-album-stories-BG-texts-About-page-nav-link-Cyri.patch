diff --git a/src/views/AboutView.vue b/src/views/AboutView.vue
new file mode 100644
index 0000000..43577f0
--- /dev/null
+++ b/src/views/AboutView.vue
@@ -0,0 +1,41 @@
+<script setup>
+import { onBeforeUnmount, onMounted, ref, nextTick } from 'vue'
+import { gsap, ScrollTrigger } from '@/lib/gsap'
+import { about } from '@/data/about'
+import me1 from '@/images/optimized/Me/me1.jpg?url'
+import me2 from '@/images/optimized/Me/me2.jpg?url'
+
+const root = ref(null)
+let ctx
+onMounted(async () => {
+  await nextTick()
+  ctx = gsap.context(() => {
+    gsap.from('.ab-title .ch', { yPercent: 110, duration: 1.3, stagger: 0.05, ease: 'expo.out', delay: 1.1 })
+    gsap.from('.ab-copy > *:not(.ab-title)', { opacity: 0, y: 30, stagger: 0.14, duration: 1.2, ease: 'expo.out', delay: 1.4 })
+    ;['.ab-photo', '.ab-second figure'].forEach((sel) => {
+      const el = root.value.querySelector(sel)
+      const img = el.firstChild
+      gsap.fromTo(el, { clipPath: 'inset(100% 0% 0% 0%)' }, { clipPath: 'inset(0% 0% 0% 0%)', duration: 1.6, ease: 'expo.out', delay: sel === '.ab-photo' ? 1 : 0, scrollTrigger: { trigger: el, start: 'top 92%' } })
+      gsap.from(img, { scale: 1.4, duration: 1.9, ease: 'expo.out', delay: sel === '.ab-photo' ? 1 : 0, scrollTrigger: { trigger: el, start: 'top 92%' } })
+      gsap.fromTo(img, { yPercent: -4 }, { yPercent: 4, ease: 'none', scrollTrigger: { trigger: el, start: 'top bottom', end: 'bottom top', scrub: true } })
+    })
+    gsap.from('.ab-quote p', { opacity: 0, y: 60, duration: 1.5, ease: 'expo.out', scrollTrigger: { trigger: '.ab-quote', start: 'top 75%' } })
+  }, root.value)
+})
+onBeforeUnmount(() => ctx?.revert())
+</script>
+<template>
+  <main ref="root" class="about">
+    <section class="ab-hero">
+      <figure class="ab-photo"><img :src="me1" alt="Portrait of the photographer" fetchpriority="high" decoding="async" @load="ScrollTrigger.refresh()" /></figure>
+      <div class="ab-copy" lang="bg">
+        <span class="label">About</span>
+        <h1 class="ab-title"><span v-for="(ch, i) in about.heading.toUpperCase().split('')" :key="i" class="mask"><span class="ch">{{ ch === ' ' ? '\u00A0' : ch }}</span></span></h1>
+        <p v-for="(para, i) in about.paragraphs" :key="i">{{ para }}</p>
+      </div>
+    </section>
+    <section class="ab-quote" lang="bg"><p>{{ about.quote }}</p></section>
+    <section class="ab-second"><figure><img :src="me2" alt="Photographer, studio portrait" loading="lazy" decoding="async" @load="ScrollTrigger.refresh()" /></figure></section>
+    <RouterLink to="/work" class="ab-cta"><span class="label">See the stories</span><h2>All work →</h2></RouterLink>
+  </main>
+</template>
