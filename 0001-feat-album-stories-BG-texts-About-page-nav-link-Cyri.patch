@@ -0,0 +1,11 @@
+// About page copy (Bulgarian)
+export const about = {
+  "heading": "За мен",
+  "paragraphs": [
+    "Вярвам, че фотографията не трябва да бъде ограничена до една естетика. Тя трябва да може да бъде нежна и едновременно с това дръзка, тиха и шумна, романтична и сурова.",
+    "В работата си търся именно този контраст — моментите, в които противоположностите започват да съществуват в един и същи кадър. Светлината среща сянката. Нежността се сблъсква с грубостта. Любовта се превръща в движение, а цветът — в емоция.",
+    "Привличат ме силните визуални решения, необичайните пространства, наситените цветове, дълбоките сенки и онези малки детайли, които променят характера на един образ. Понякога търся красотата в тишината, друг път — в хаоса, напрежението и необузданата енергия.",
+    "Затова и фотографията ми постоянно се движи между крайности — от интимността на един поглед до силата на ринга, от мекотата на изгрева до дълбочината на червеното, от природната суровост до изкуствената светлина."
+  ],
+  "quote": "Не търся един стил. Търся своя начин да разказвам."
+}
