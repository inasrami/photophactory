diff --git a/src/data/stories.js b/src/data/stories.js
new file mode 100644
index 0000000..f2b9b87
--- /dev/null
+++ b/src/data/stories.js
@@ -0,0 +1,60 @@
+// Story texts for each album (Bulgarian). Keyed by the folder in gallery.js.
+export const stories = {
+  "portraits/cowgirl - Kalina": {
+    "title": "Golden West",
+    "titleBg": "Златен запад",
+    "text": [
+      "Фотосесията е заснета в края на лятото, по време на залез, когато топлата светлина превръща пейзажа в естествена част от историята. Идеята е да се улови усещането за топлина, свобода и безгрижие, характерно за последните дни на лятото.",
+      "Визуалната посока е вдъхновена от кънтри и каубойската естетика, но е представена по-нежно и женствено. Вместо да се акцентира върху по-грубия и суров характер на western стила, той е омекотен чрез естествената светлина, деликатното движение и спокойното присъствие на модела."
+    ]
+  },
+  "portraits/Godej": {
+    "title": "Light Between Us",
+    "titleBg": "Светлина между нас",
+    "text": [
+      "“Light Between Us” е визуален разказ за любовта, уловена в тишината и красотата на Призрен. Заснета в естествената слънчева светлина на джамията, серията използва светлината не просто като визуален елемент, а като част от историята между двамата. Меките сенки, спокойното пространство и близостта помежду им създават усещане за интимност и искреност. Фотосесията търси красотата в онези тихи моменти, в които любовта не е демонстративна, а просто присъства."
+    ]
+  },
+  "portraits/Ivan i Zdravka": {
+    "title": "Tide of Light",
+    "titleBg": "Прилив на светлина",
+    "text": [
+      "“Tide of Light” е визуален разказ за любовта в един от най-тихите моменти на деня. Заснета по изгрев на плажа, сесията улавя играта, близостта и лекотата между двама влюбени, докато първите слънчеви лъчи превръщат морето в естествен декор на тяхната история. Изгревът е романтизиран не просто като фон, а като усещане за ново начало — момент, в който светът все още е тих, а двамата съществуват единствено един за друг."
+    ]
+  },
+  "portraits/Valeto": {
+    "title": "Floor Zero",
+    "titleBg": "Етаж нула",
+    "text": [
+      "“Floor Zero” е визуална игра със светлина, цвят и архитектура, вдъхновена от винтидж усещането на софийските панелни квартали. Зелените сенки се превръщат в основен визуален елемент, който променя познатата градска среда и ѝ придава почти кинематографичен характер. Суровите линии на блоковете се срещат с човешкото присъствие, създавайки контраст между познатото градско пространство и една по-ексцентрична, носталгична версия на София."
+    ]
+  },
+  "portraits/Vika": {
+    "title": "Breath of Wind",
+    "titleBg": "Дъх на вятър",
+    "text": [
+      "“Breath of Wind” е визуално изследване на женствеността като естествена форма на сила. Декорът и облеклото са изградени около материали и елементи, вдъхновени от природата — дърво, кожа, планински пейзажи, дантела, вятър и сребро. Грубите текстури се срещат с женското присъствие, създавайки контраст между суровост и красота. Сесията представя женствеността не като крехкост, а като сила, която съществува естествено и уверено."
+    ]
+  },
+  "portraits/Vikaskilim": {
+    "title": "Inside",
+    "titleBg": "Вътре",
+    "text": [
+      "“Inside” пресъздава уединено пространство, изградено чрез богати текстури, топла светлина и дълбоки сенки. Персийският килим се превръща в основен елемент от средата, добавяйки усещане за история, лукс и тежест. Топлата светлина обгръща модела и подчертава златистите тонове във визията, докато цигарата и димът допълват атмосферата с леко мистериозно и кинематографично усещане. Заснета през нощта, серията изгражда образ, който е едновременно чувствен, тежък и загадъчен."
+    ]
+  },
+  "portraits/Elena": {
+    "title": "DEEP RED",
+    "titleBg": "DEEP RED",
+    "text": [
+      "“DEEP RED” е визуално изследване на женския образ, изградено около дълбочината и силата на червения цвят. Червеният фон с изразена текстура създава плътна визуална среда, в която моделът се превръща в основния фокус. Работата в топлата цветова гама подчертава усещането за наситеност и драматичност, а в определени моменти контрастната светлина добавя напрежение и променя характера на образа. Бижутата и контрастният грим са използвани като акценти, които допълват композицията и подчертават детайлите в лицето и присъствието на модела. Сесията е концентрирана върху погледа, текстурата и силата на един образ, изведен от дълбочината на червеното."
+    ]
+  },
+  "fightNight": {
+    "title": "Fight Night 6",
+    "titleBg": "Fight Night 6",
+    "text": [
+      "Снимки, разказващи за енергията, напрежението и емоцията, които съществуват около ринга. Дълбоките сенки и контрастната светлина изграждат сурова и динамична атмосфера, в която всеки момент носи усещане за движение и напрежение. В центъра е рингът — мястото, където светлината, ударите и адреналинът се срещат, но историята не остава само там. Кадрите улавят реакциите на публиката, концентрацията на бойците и онези кратки мигове между напрежението и експлозията. Серията търси не просто битката, а човешката емоция зад нея — силата, очакването, страха и адреналина, които превръщат една нощ в преживяване."
+    ]
+  }
+}
